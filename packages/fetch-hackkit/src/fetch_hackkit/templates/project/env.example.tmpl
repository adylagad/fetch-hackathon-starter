# Your agent's identity. `hackkit new` already generated one into .env.
# Never commit .env: the seed *is* your agent (address + wallet).
AGENT_SEED_PHRASE=

# ASI:One LLM key: https://asi1.ai/developer
ASI_ONE_API_KEY=
# ASI_ONE_MODEL=asi1

# Agentverse API key: https://agentverse.ai/profile/api-keys
# With it, the agent registers itself (name, @handle, description, README) on startup.
AGENTVERSE_API_KEY=

# Your unique @handle on Agentverse (max 40 chars). Check: uv run hackkit handle <name>
AGENT_HANDLE=__AGENT_HANDLE__

# AGENT_PORT=8000
# FET_NETWORK=stable-testnet   # or mainnet (real money!)
